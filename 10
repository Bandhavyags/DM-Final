import pandas as pd
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import DecisionTreeClassifier, export_text
from sklearn.model_selection import cross_val_score

# Load dataset
data = pd.read_csv("GermanCredit.csv")

# Encode data
le = LabelEncoder()
for col in data.columns:
    if data[col].dtype == object:
        data[col] = le.fit_transform(data[col])

X = data.iloc[:, :-1]
y = data.iloc[:, -1]

# J48
j48 = DecisionTreeClassifier(criterion='entropy')
j48.fit(X, y)
print("J48 Tree")
print(export_text(j48, feature_names=list(X.columns)))
print("Accuracy:", cross_val_score(j48, X, y, cv=10).mean()*100)

# PART
part = DecisionTreeClassifier(criterion='entropy', max_depth=3)
part.fit(X, y)
print("\nPART Rules")
print(export_text(part, feature_names=list(X.columns)))
print("Accuracy:", cross_val_score(part, X, y, cv=10).mean()*100)

# OneR
X1 = data[['credit_history']]
oner = DecisionTreeClassifier(criterion='entropy', max_depth=1)
oner.fit(X1, y)
print("\nOneR Rule")
print(export_text(oner, feature_names=['credit_history']))
print("Accuracy:", cross_val_score(oner, X1, y, cv=10).mean()*100)
