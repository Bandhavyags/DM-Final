# PROGRAM 9: Pruning — Reduced Error Pruning (Simulated)

import pandas as pd
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.model_selection import cross_val_score
import matplotlib.pyplot as plt

data = pd.read_csv("/content/drive/MyDrive/Colab Notebooks/german_credit.csv")

le = LabelEncoder()

for col in data.columns:
    if data[col].dtype == object:
        data[col] = le.fit_transform(data[col])

X = data.iloc[:, :-1]
y = data.iloc[:, -1]

# Unpruned Decision Tree
unpruned = DecisionTreeClassifier(
    criterion='entropy',
    random_state=42
)

s1 = cross_val_score(unpruned, X, y, cv=10)

# Pruned Decision Tree (simulating Reduced Error Pruning)
pruned = DecisionTreeClassifier(
    criterion='entropy',
    max_depth=4,
    min_samples_leaf=10,
    random_state=42
)

s2 = cross_val_score(pruned, X, y, cv=10)

# Train pruned model on the full dataset for visualization
pruned.fit(X, y)

# Plot the pruned Decision Tree
plt.figure(figsize=(18, 10))
plot_tree(
    pruned,
    feature_names=X.columns,
    class_names=True,
    filled=True
)
plt.title("Pruned Decision Tree")
plt.show()

# Print results
print(f"Unpruned Avg Accuracy : {s1.mean()*100:.2f}%")
print(f"Cross-validation scores (Unpruned): {s1}")

print(f"\nPruned Avg Accuracy : {s2.mean()*100:.2f}%")
print(f"Cross-validation scores (Pruned): {s2}")

print(f"\nImprovement : {(s2.mean()-s1.mean())*100:+.2f}%")
